# NeMeSiS SHARK PRO - Render production env
# No contiene secretos reales. Rellenar valores en Render > Environment.

# Core
DB_PATH=/data/database.db
SECRET_KEY=
FLASK_DEBUG=0

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_NAME=Admin SHARK

# Sports data
THESPORTSDB_KEY=
ENABLE_LIVE_API=true

# Odds / value
THE_ODDS_API_KEY=
ENABLE_ODDS_API=true
ODDS_CACHE_MINUTES=20
ODDS_REGIONS=eu,uk
ODDS_MARKETS=h2h

# Scheduler
ENABLE_AUTO_SYNC=true
SCHEDULER_ENABLED=true
AUTO_SYNC_ON_STARTUP=true
RUN_STARTUP_SCHEDULER_NOW=0
DAILY_AUTOMATION_ENABLED=true
RUN_DAILY_AUTOMATION=true
SPORTSDB_SYNC_HOURS=6
CREST_SYNC_HOURS=24
LIVE_CACHE_MINUTES=2
RECOMMENDATIONS_REFRESH_MINUTES=30
AUTO_PICKS_REFRESH_MINUTES=45
LIVE_ALERTS_REFRESH_MINUTES=5
WAREHOUSE_REFRESH_HOURS=12
SCHEDULER_LOG_CLEANUP_HOURS=24
SCHEDULER_LOG_MAX_ROWS=300
TELEGRAM_PREPARE_HOURS=6
POPULATION_WARMUP_HOURS=6
POPULATION_WARMUP_LIMIT=80

# Autopilot picks
AUTO_GENERATE_PICKS=true
AUTO_SEND_TELEGRAM_PICKS=true
MIN_SHARK_SCORE_FOR_AUTO_SEND=78
MAX_AUTO_PICKS_PER_DAY=3
TELEGRAM_AUTO_SEND_WINDOW_HOURS=24

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=nemesi_shark_pro_bot
ENABLE_TELEGRAM_AUTO=true
ENABLE_TELEGRAM_AUTOMATION=true
TELEGRAM_AUTO_SEND_ENABLED=true

# Optional cron protection
AUTOMATION_SECRET=

# SQLite tuning
SQLITE_TIMEOUT_SECONDS=30
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_RETRY_ATTEMPTS=5
SQLITE_RETRY_BASE_SLEEP=0.15

# Future Stripe readiness only
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# V601 API Exploitation Engine
API_FOOTBALL_KEY=
ENABLE_API_FOOTBALL_PROVIDER=true
API_EXPLOITATION_DEEP_LIMIT=12
API_EXPLOITATION_REFRESH_HOURS=6
API_EXPLOITATION_FORM_SAMPLE=10
API_EXPLOITATION_H2H_LAST=10


# Telegram PRO calibration
# Tick recomendado en Render: */15 * * * *
# Daily recomendado en Render: 0 * * * *
TELEGRAM_MAX_MESSAGES_PER_HOUR=1
TELEGRAM_MAX_MESSAGES_PER_DAY=8
TELEGRAM_MAX_QUEUE_PER_TICK=3
TELEGRAM_MAX_AUTO_PICKS_PER_TICK=2
TELEGRAM_MAX_AUTO_PICKS_PER_DAY=4
MIN_SHARK_SCORE_FOR_AUTO_SEND=75
TELEGRAM_MIN_ODDS=1.40
TELEGRAM_MAX_ODDS=4.50
TELEGRAM_QUIET_START=00:30
TELEGRAM_QUIET_END=09:30
TELEGRAM_DAILY_SUMMARY_START=09:30
TELEGRAM_DAILY_SUMMARY_END=12:30
TELEGRAM_DAILY_PICKS_START=13:00
TELEGRAM_DAILY_PICKS_END=20:30

# Telegram PRO: solo fútbol automático. Cambiar a multi solo si quieres otros deportes.
TELEGRAM_SPORT_MODE=football_only
TELEGRAM_FOOTBALL_ONLY=true

# Data Memory / Histórico SHARK
DATA_MEMORY_ENABLED=true
DATA_MEMORY_KEEP_DAYS=180
ODDS_SNAPSHOT_KEEP_DAYS=90
LIVE_SNAPSHOT_KEEP_DAYS=30
TELEGRAM_LOG_KEEP_DAYS=90
DATA_MEMORY_RAW_JSON=false
DATA_MEMORY_MAX_JSON_CHARS=6000

# V734 Payments / Stripe foundation
APP_PUBLIC_URL=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_MODE=audit

# V753 Render Cron Telegram automatico
# Cron Job command: python tools/render_cron_telegram_tick.py
# Cron Job env only needs PUBLIC_BASE_URL and AUTOMATION_SECRET.
TELEGRAM_AUTO_SEND_ENABLED=true
ENABLE_TELEGRAM_AUTOMATION=true
AUTO_SEND_TELEGRAM_PICKS=true
ENABLE_TELEGRAM_AUTO=true
TELEGRAM_PICK_SEND_WINDOW_HOURS_BEFORE=24
TELEGRAM_PICK_SEND_MIN_MINUTES_BEFORE=15
TELEGRAM_PICK_WINDOW_HOURS_BEFORE=24
TELEGRAM_PICK_MIN_MINUTES_BEFORE=15
TELEGRAM_PICK_PRO_SLOTS=10:00-13:30,17:00-21:30
TELEGRAM_PICK_URGENT_MINUTES_BEFORE=90
TELEGRAM_SUMMARY_MORNING_WINDOW=09:00-11:30
TELEGRAM_SUMMARY_EVENING_WINDOW=17:00-19:30
TELEGRAM_SUMMARY_WINDOWS=09:00-11:30,17:00-19:30
TELEGRAM_AUTO_PICK_RESPECT_QUIET_HOURS=false
AUTO_GENERATE_PICKS=true
TZ=Europe/Madrid
APP_TIMEZONE=Europe/Madrid
PUBLIC_BASE_URL=https://bot-apuestas-crgf.onrender.com

# V768 pick result grading / track record automation
PICK_GRADING_REFRESH_HOURS=6
ENABLE_PICK_GRADING_AUTOMATION=true
